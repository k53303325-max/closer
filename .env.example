# Telegram
BOT_TOKEN=

# Database (async SQLAlchemy URL)
DATABASE_URL=postgresql+asyncpg://closer:closer@localhost:5432/closer

# Redis (FSM + arq queue)
REDIS_URL=redis://localhost:6379/0

# GigaChat (Sber API); without key — FakeLLM
GIGACHAT_AUTH_KEY=

# SMS: fake | smsc | smsaero
SMS_PROVIDER=fake
SMS_API_KEY=
SMS_LOGIN=
SMS_TEST_PHONE=+7XXXXXXXXXX

# Storage: local | s3
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./data

# S3-compatible object storage (when STORAGE_BACKEND=s3)
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
S3_REGION=

# AES-GCM key for passport and address (32 bytes, base64)
PD_ENCRYPTION_KEY=

# Policy link (placeholder until final text)
PD_POLICY_URL=https://example.com/pd-policy

PEP_OFFER_VERSION=pep_offer_v1

# Paid contract after free quota (YooKassa — later)
CONTRACT_PRICE_RUB=99

# Comma-separated Telegram user IDs with admin access
ADMIN_TG_IDS=7134126078
# Or usernames without @
ADMIN_TG_USERNAMES=markusvalerius

# Vercel only: public origin without trailing slash
WEBHOOK_URL=
